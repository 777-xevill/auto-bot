# Copy to .env and fill in. .env is git-ignored - never commit it.

# Required: your Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Telegram remote control (free): token from @BotFather. Use a bot nothing else runs.
TELEGRAM_BOT_TOKEN=
# TELEGRAM_OWNER_ID=                 # optional; otherwise pair with /pair <code>

# --- Optional settings (defaults shown) ---
# AUTOBOT_MODEL=claude-opus-5-5
# AUTOBOT_EFFORT=medium              # low | medium | high | xhigh | max
# AUTOBOT_BUDGET_USD=5               # per task; the agent asks before going over
# AUTOBOT_MAX_STEPS=300              # per task; the agent asks before going over
# AUTOBOT_SCREENSHOT_WIDTH=1280      # screenshots are scaled to this width
# AUTOBOT_SAVE_SCREENSHOTS=false     # keep every screenshot in runs/<id>/screens
# AUTOBOT_BROWSER_CHANNEL=chrome     # chrome | msedge | (empty = bundled chromium)
# AUTOBOT_BROWSER_HEADLESS=false
# AUTOBOT_BROWSER_JS=true            # let the agent run JavaScript in its browser to extract data
# AUTOBOT_SHELL_CONFIRM=risky        # risky | always | never
# AUTOBOT_OUTPUT_DIR=E:\auto-bot\output
# AUTOBOT_DOWNLOADS_DIR=%USERPROFILE%\Downloads
# AUTOBOT_PAUSE_HOTKEY=<ctrl>+<alt>+p
# AUTOBOT_STOP_HOTKEY=<ctrl>+<alt>+x
# AUTOBOT_FALLBACKS=true             # retry on another Claude model if a step is declined
# AUTOBOT_PROGRESS_UPDATES=true      # show the agent's short notes between actions
